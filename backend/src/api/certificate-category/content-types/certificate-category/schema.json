{
  "kind": "collectionType",
  "collectionName": "certificate_categories",
  "info": {
    "singularName": "certificate-category",
    "pluralName": "certificate-categories",
    "displayName": "Certificate Category"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "certificates": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::certificate.certificate",
      "mappedBy": "category"
    }
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  }
}
